{
  "SDKVersion": 2,
  "Name": "Mic Mute",
  "Version": "1.0.0",
  "Author": "Your Name",
  "Description": "Toggle mute on your default Windows microphone. The key stays in sync if the mic is muted elsewhere.",
  "Icon": "images/pluginIcon",
  "Category": "Mic Mute",
  "CategoryIcon": "images/categoryIcon",
  "CodePath": "bin/MicMute.exe",
  "CodePathWin": "bin/MicMute.exe",
  "UUID": "com.local.micmute",
  "OS": [
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Software": {
    "MinimumVersion": "2.9"
  },
  "Actions": [
    {
      "UUID": "com.local.micmute.toggle",
      "Name": "Toggle Mic Mute",
      "Tooltip": "Mute / unmute your default microphone",
      "Icon": "images/actionIcon",
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "images/micOn",  "ShowTitle": false },
        { "Image": "images/micOff", "ShowTitle": false }
      ]
    }
  ]
}
